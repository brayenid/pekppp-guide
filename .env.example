# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# JWT & Session Secret Key (Minimal 32 karakter acak untuk keamanan HS256)
AUTH_SECRET="ganti-dengan-kunci-rahasia-minimal-32-karakter-acak"

# Google Gemini API Key for AI Pre-Evaluator (Multimodal PDF, Sarpras & Uniform inspection)
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Cloudflare Turnstile CAPTCHA (Bot Protection di Login)
# Dapatkan dari Cloudflare Dashboard > Turnstile
# Catatan: Jika dikosongkan pada environment lokal, sistem otomatis menggunakan Dummy Testing Keys resmi Cloudflare (Always Passes)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
